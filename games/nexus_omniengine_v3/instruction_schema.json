  "type": "object",
  "properties": {
    "instruction_id": {"type": "string"},
    "agent_type": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "description": {"type": "string"},
